# Diamond Agent local configuration.
# Copy to .env and edit; real environment variables override these values.

# ---- federation -------------------------------------------------------
# Site catalog produced by `make init-sites` (every resource is a live probe
# of a real system reached through Diamond / Globus Compute).
#DIAMOND_AGENT_SITES=sites.live.yaml

# Seconds per federation refresh (the minute-level view). Raise if preflight
# shows slow probes.
#DIAMOND_AGENT_TICK=60

DIAMOND_AGENT_DB=diamond_agent.db
# JSONL stream feeding RQ1-RQ4 tooling; set to "off" to disable.

# ---- AI half of the meta-scheduler (optional) ------------------------
# Requires `uv pip install -e ".[ai]"`. Without a key the scheduler and the
# envelope generator fall back to deterministic heuristics.
#ANTHROPIC_API_KEY=sk-ant-...
#DIAMOND_AGENT_MODEL=claude-opus-5

# ---- live-mode credentials (pick ONE; see diamond_agent/auth.py) -----
# 1) Diamond dashboard session: the `tokens` cookie JSON, inline or @file.
#DIAMOND_AGENT_TOKENS=@/path/to/diamond_tokens.json
# 2) Globus confidential client (service identity, non-interactive).
#GLOBUS_COMPUTE_CLIENT_ID=...
#GLOBUS_COMPUTE_CLIENT_SECRET=...
# 3) Neither set -> native login; run `make login` once (tokens are cached
#    in ~/.globus_compute/storage.db, so nothing goes in this file).

# 1 (default) serves the web UI; 0 runs diamond-agent-core headless (API only)
#DIAMOND_AGENT_UI=1        # `make core` forces 0 (headless) regardless
# Base URL the CLI / MCP server talk to
DIAMOND_AGENT_URL=http://127.0.0.1:8642

# ---- Frontend sign-in (Globus OAuth, Diamond-dashboard style) ----------------
# Only used when the web UI is served. A Globus *confidential* client whose
# registered redirect URI is <DIAMOND_AGENT_PUBLIC_URL>/auth/callback
# (e.g. http://127.0.0.1:8642/auth/callback). The standalone core (CLI, MCP,
# other agents) keeps `python -m diamond_agent.auth login` and does not need these.
# NOTE: these are NOT GLOBUS_COMPUTE_CLIENT_ID/SECRET — those switch the whole core
# to a *service identity* (the app acts as itself, which cannot see your endpoints).
GLOBUS_CLIENT_ID=
GLOBUS_CLIENT_SECRET=
# External base URL for the OAuth redirect when behind a proxy (default: request origin)
# DIAMOND_AGENT_PUBLIC_URL=http://127.0.0.1:8642
# Where the web session (token bundle, mode 0600) is kept
# DIAMOND_AGENT_HOME=~/.diamond_agent
